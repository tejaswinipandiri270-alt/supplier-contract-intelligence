# Application
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
TOP_K=8
MIN_RETRIEVAL_SCORE=0.15
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local OpenSearch (Docker Compose)
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=supplier-contract-chunks
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# Azure OpenAI - required for generated answers; without these, extractive demo answers are used
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=

# AWS - set these for cloud mode; use IAM roles in ECS, not static AWS keys
AWS_REGION=eu-west-2
S3_BUCKET=
S3_PREFIX=supplier-contracts/
USE_S3=false
AWS_OPENSEARCH_HOST=
AWS_OPENSEARCH_USERNAME=
AWS_OPENSEARCH_PASSWORD=
AWS_OPENSEARCH_USE_AWS_AUTH=false

# Streamlit
API_URL=http://localhost:8000
